// Natural Language Specification DSL - CST-oriented Grammar
// Preserves complete document structure including all whitespace

?start: specification

specification: header definitions state_section operations? constraints NEWLINE*

// ============ Header Section ============
header: "System:" WS* system_name NEWLINE+ description

system_name: text_line

// Description can be single or multi-line paragraph
description: text_paragraph

// ============ Definitions Section ============
definitions: NEWLINE+ "The" WS "system" WS "uses" WS "these" WS "concepts:" NEWLINE concept_list

concept_list: concept_def+

concept_def: "-" WS* concept_name ":" WS* concept_description NEWLINE

concept_name: identifier (WS identifier)*

concept_description: text_line

// ============ State Section ============
state_section: NEWLINE+ "The" WS "system" WS "maintains:" NEWLINE+ state_list

// Allow optional newlines between state blocks
state_list: (state_block NEWLINE*)+

state_block: state_header state_properties

state_header: state_name ":" NEWLINE

state_name: identifier (WS identifier)*

state_properties: (INDENT property_line)+

property_line: text_line NEWLINE

// ============ Operations Section ============
operations: operation*

operation: NEWLINE+ "When" WS trigger ":" NEWLINE operation_body

operation_body: preconditions transition_marker effects

trigger: text_line

// Preconditions with base indentation
preconditions: (INDENT precondition_line)*

precondition_line: text_line NEWLINE

// Transition marker at same indentation as preconditions
transition_marker: INDENT "Then:" NEWLINE

// Effects with nested indentation
effects: effect+

effect: DOUBLE_INDENT "-" WS* effect_content

// Effect content can span multiple lines with continued indentation
effect_content: text_line NEWLINE (DOUBLE_INDENT WS* text_line NEWLINE)*

// ============ Constraints Section ============
constraints: NEWLINE+ "System" WS "Constraints:" NEWLINE+ constraint_list guarantees?

guarantees: NEWLINE+ "System" WS "Guarantees:" NEWLINE+ guarantee_list

constraint_list: (constraint_item NEWLINE*)+

guarantee_list: (guarantee_item NEWLINE*)+

constraint_item: named_property
guarantee_item: named_property

named_property: property_name ":" NEWLINE INDENT property_content

property_name: identifier (WS identifier)*

// Property content can be multi-line with consistent indentation
property_content: text_line (NEWLINE INDENT text_line)*

// ============ Text Components ============
text_line: (WORD | NUMBER | SYMBOL | WS)+

// Paragraph structure for descriptions - handles single or multi-line
text_paragraph: text_line (NEWLINE text_line)* NEWLINE?

identifier: WORD

// ============ Terminals ============
WORD: /[a-zA-Z][a-zA-Z0-9_]*/
NUMBER: /[0-9]+/
SYMBOL: /[.,;:!?\-_()\/'"@#$%&*+=\[\]{}|\\<>~`^]/

// Whitespace - preserve exact formatting
WS: /[ \t]+/
INDENT: /  /           // Exactly 2 spaces
DOUBLE_INDENT: /    /  // Exactly 4 spaces
NEWLINE: /\r?\n/

// Don't ignore any whitespace - preserve everything in CST