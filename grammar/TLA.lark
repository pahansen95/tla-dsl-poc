// Natural Language Specification DSL - Lark Grammar
// Fixed version with proper operation handling

?start: specification

specification: header definitions state_section operations? constraints

// ============ Header Section ============
header: "System:" WS* system_name NEWLINE description

system_name: text_line

description: text_paragraph

// ============ Definitions Section ============
definitions: NEWLINE "The" WS "system" WS "uses" WS "these" WS "concepts:" NEWLINE concept_list

concept_list: concept_def+

concept_def: "-" WS* concept_name ":" WS* concept_description NEWLINE

concept_name: identifier (WS identifier)*

concept_description: text_line

// ============ State Section ============
state_section: NEWLINE "The" WS "system" WS "maintains:" NEWLINE NEWLINE state_list

state_list: state_block+

state_block: state_header state_properties

state_header: state_name ":" NEWLINE

state_name: identifier (WS identifier)*

state_properties: (INDENT property_line)+

property_line: text_line NEWLINE

// ============ Operations Section ============
// Made operations optional with ? and changed to operation*
operations: operation*

operation: NEWLINE "When" WS trigger ":" NEWLINE preconditions INDENT "Then:" NEWLINE effects

trigger: text_line

preconditions: (INDENT precondition_line)*

precondition_line: text_line NEWLINE

effects: (INDENT "-" WS* effect_line)+

effect_line: text_line NEWLINE

// ============ Constraints Section ============
constraints: NEWLINE "System" WS "Constraints:" NEWLINE NEWLINE constraint_list guarantees?

guarantees: NEWLINE "System" WS "Guarantees:" NEWLINE NEWLINE guarantee_list

constraint_list: constraint_item+

guarantee_list: guarantee_item+

constraint_item: named_property
guarantee_item: named_property

named_property: property_name ":" NEWLINE INDENT property_value NEWLINE?

property_name: identifier (WS identifier)*

property_value: text_line

// ============ Text Components ============
text_line: (WORD | NUMBER | SYMBOL | WS)+

text_paragraph: (text_line NEWLINE)+

identifier: WORD

// ============ Terminals ============
WORD: /[a-zA-Z][a-zA-Z0-9_]*/
NUMBER: /[0-9]+/
SYMBOL: /[.,;:!?\-_()\/'"@#$%&*+=\[\]{}|\\<>~`^]/

// Whitespace
WS: /[ \t]+/
INDENT: /  /  // Two spaces
NEWLINE: /\r?\n/

// Ignore extra whitespace between tokens
%ignore /[ \t]+(?=[ \t])/  // Collapse multiple spaces